<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_patient_list" model="ir.ui.view">
        <field name="name">res.partner.list.dental.patient</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Hastalar">
                <field name="name"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="birth_date"/>
                <field name="identification_no"/>
                <field name="nationality_id"/>
                <field name="country_id" optional="hide"/>
                <field name="is_international_patient" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dental_patient_form" model="ir.ui.view">
        <field name="name">res.partner.form.dental.patient</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Hasta">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_dental_quick_price" type="object" class="oe_stat_button" icon="fa-calculator">
                            <div class="o_stat_info"><span class="o_stat_text">Hızlı</span><span class="o_stat_text">Fiyat</span></div>
                        </button>
                        <button name="action_dental_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Randevu"/>
                        </button>
                        <button name="action_dental_treatment_plans" type="object" class="oe_stat_button" icon="fa-medkit">
                            <field name="treatment_plan_count" widget="statinfo" string="Tedavi Planı"/>
                        </button>
                        <button name="action_dental_quotes" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                groups="sales_team.group_sale_salesman">
                            <field name="sale_order_count" widget="statinfo" string="Teklif / Sipariş"/>
                        </button>
                        <button name="action_dental_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                groups="account.group_account_invoice,account.group_account_readonly">
                            <field name="dental_invoice_count" widget="statinfo" string="Fatura"/>
                        </button>
                        <button name="action_dental_invoices" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="not credit" groups="account.group_account_invoice,account.group_account_readonly">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="credit" widget="monetary"/></span>
                                <span class="o_stat_text">Bakiye</span>
                            </div>
                        </button>
                        <button name="action_dental_cases" type="object" class="oe_stat_button" icon="fa-folder-open-o"
                                invisible="not dental_case_count">
                            <field name="dental_case_count" widget="statinfo" string="Vaka"/>
                        </button>
                        <button name="action_dental_consents" type="object" class="oe_stat_button" icon="fa-check-square-o"
                                invisible="not dental_consent_count">
                            <field name="dental_consent_count" widget="statinfo" string="Onam"/>
                        </button>
                        <button name="action_dental_lab_orders" type="object" class="oe_stat_button" icon="fa-flask"
                                invisible="not dental_lab_order_count">
                            <field name="dental_lab_order_count" widget="statinfo" string="Laboratuvar"/>
                        </button>
                        <button name="action_dental_travel" type="object" class="oe_stat_button" icon="fa-plane"
                                invisible="not dental_travel_count and not is_international_patient">
                            <field name="dental_travel_count" widget="statinfo" string="Seyahat"/>
                        </button>
                        <button name="action_dental_opportunities" type="object" class="oe_stat_button" icon="fa-star"
                                invisible="not opportunity_count" groups="sales_team.group_sale_salesman">
                            <field name="opportunity_count" widget="statinfo" string="Fırsat"/>
                        </button>
                        <button name="action_dental_whatsapp" type="object" class="oe_stat_button" icon="fa-whatsapp"
                                invisible="not mobile and not phone">
                            <div class="o_stat_info"><span class="o_stat_text">WhatsApp</span></div>
                        </button>
                    </div>
                    <field name="is_international_patient" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="alert alert-info py-2 mb-3" role="status" invisible="not dental_upcoming_appointment">
                        <i class="fa fa-calendar-check-o me-1"/> Sıradaki randevu:
                        <field name="dental_upcoming_appointment" readonly="1" class="fw-bold"/>
                    </div>
                    <field name="is_dental_patient" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Hasta Adı"/>
                        <h1><field name="name" placeholder="Hasta Adı Soyadı"/></h1>
                    </div>
                    <group>
                        <group string="İletişim">
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                        <group string="Kişisel Bilgiler">
                            <field name="identification_no"/>
                            <field name="passport_no"/>
                            <field name="nationality_id"/>
                            <field name="country_id" string="İkamet Ülkesi"/>
                            <field name="lang" string="Konuştuğu Dil"/>
                            <field name="birth_date"/>
                            <field name="blood_type"/>
                            <field name="referral_source"/>
                            <field name="referring_agency_id"
                                   invisible="referral_source != 'agency'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Sağlık Bilgileri">
                        <field name="allergies" placeholder="Bilinen alerjiler..."/>
                        <field name="anamnesis" placeholder="Genel sağlık geçmişi, kronik hastalıklar..."/>
                    </group>
                    <notebook>
                        <page name="appointments" string="Randevular">
                            <field name="appointment_ids" nolabel="1">
                                <list>
                                    <field name="start_datetime"/>
                                    <field name="doctor_id"/>
                                    <field name="appointment_type"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="treatment_plans" string="Tedavi Planları">
                            <field name="treatment_plan_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="doctor_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="travel_info" string="Seyahat Bilgileri"
                              invisible="not is_international_patient">
                            <field name="travel_info_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="arrival_date"/>
                                    <field name="departure_date"/>
                                    <field name="hotel_name"/>
                                    <field name="needs_transfer"/>
                                    <field name="needs_translator"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_patient" model="ir.actions.act_window">
        <field name="name">Hastalar</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dental_patient', '=', True)]</field>
        <field name="context">{'default_is_dental_patient': True, 'default_is_company': False}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_dental_patient_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dental_patient_form')}),
        ]"/>
    </record>

    <record id="view_dental_agency_list" model="ir.ui.view">
        <field name="name">res.partner.list.dental.agency</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Sağlık Turizmi Acenteleri">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="country_id"/>
                <field name="commission_rate"/>
            </list>
        </field>
    </record>

    <record id="view_dental_agency_form" model="ir.ui.view">
        <field name="name">res.partner.form.dental.agency</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Sağlık Turizmi Acentesi">
                <sheet>
                    <field name="is_health_tourism_agency" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Acente Adı"/></h1>
                    </div>
                    <group>
                        <group string="İletişim">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Komisyon">
                            <field name="commission_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="referred_patients" string="Yönlendirilen Hastalar">
                            <field name="dental_patient_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="nationality_id"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page name="commissions" string="Komisyonlar">
                            <field name="commission_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="treatment_plan_id"/>
                                    <field name="invoice_amount"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_agency" model="ir.actions.act_window">
        <field name="name">Sağlık Turizmi Acenteleri</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_health_tourism_agency', '=', True)]</field>
        <field name="context">{'default_is_health_tourism_agency': True, 'default_is_company': True}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_dental_agency_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dental_agency_form')}),
        ]"/>
    </record>
</odoo>
