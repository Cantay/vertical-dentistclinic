<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_consent_list" model="ir.ui.view">
        <field name="name">dental.consent.list</field>
        <field name="model">dental.consent</field>
        <field name="arch" type="xml">
            <list string="Onam Formları">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="treatment_plan_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'signed'"
                       decoration-danger="state == 'declined'"
                       decoration-info="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="view_dental_consent_form" model="ir.ui.view">
        <field name="name">dental.consent.form</field>
        <field name="model">dental.consent</field>
        <field name="arch" type="xml">
            <form string="Onam Formu">
                <header>
                    <button name="action_send" type="object" string="Hastaya Gönder"
                            invisible="state not in ('draft',)" class="oe_highlight"/>
                    <button name="action_reset_draft" type="object" string="Taslağa Al"
                            invisible="state != 'declined'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="treatment_plan_id"/>
                            <field name="patient_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="signed_date" readonly="1"/>
                            <field name="signer_name" readonly="1"/>
                        </group>
                    </group>
                    <group string="Onam Metni">
                        <field name="consent_text" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_consent" model="ir.actions.act_window">
        <field name="name">Onam Formları</field>
        <field name="res_model">dental.consent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
