<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_list" model="ir.ui.view">
        <field name="name">dental.appointment.list</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <list string="Randevular">
                <field name="start_datetime"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_type"/>
                <field name="source" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state in ('no_show', 'cancelled')"
                       decoration-info="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_dental_appointment_form" model="ir.ui.view">
        <field name="name">dental.appointment.form</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <form string="Randevu">
                <header>
                    <button name="action_confirm" type="object" string="Onayla"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_done" type="object" string="Geldi"
                            invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_no_show" type="object" string="Gelmedi"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="İptal"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_type"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="stop_datetime"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="treatment_plan_id"/>
                            <field name="source" readonly="1"/>
                            <field name="reminder_sent"/>
                        </group>
                    </group>
                    <group string="Notlar">
                        <field name="notes" nolabel="1"/>
                        <field name="treatment_line_ids" nolabel="1" readonly="1" invisible="not treatment_line_ids">
                            <list>
                                <field name="tooth_number"/>
                                <field name="tooth_dentition" widget="badge"/>
                                <field name="procedure_id"/>
                                <field name="duration" widget="float_time"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_appointment_calendar" model="ir.ui.view">
        <field name="name">dental.appointment.calendar</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Randevular" date_start="start_datetime" date_stop="stop_datetime"
                      color="doctor_id" mode="week">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_type"/>
            </calendar>
        </field>
    </record>

    <record id="action_dental_appointment" model="ir.actions.act_window">
        <field name="name">Randevular</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
