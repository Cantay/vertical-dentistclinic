<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_lab_order_list" model="ir.ui.view">
        <field name="name">dental.lab.order.list</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <list string="Laboratuvar Talepleri">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="lab_partner_id"/>
                <field name="work_type"/>
                <field name="tooth_number"/>
                <field name="sent_date"/>
                <field name="expected_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'received'"
                       decoration-danger="state == 'cancelled'"
                       decoration-info="state in ('sent', 'in_progress')"/>
            </list>
        </field>
    </record>

    <record id="view_dental_lab_order_form" model="ir.ui.view">
        <field name="name">dental.lab.order.form</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <form string="Laboratuvar Talebi">
                <header>
                    <button name="action_send" type="object" string="Laboratuvara Gönder"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_in_progress" type="object" string="Üretimde"
                            invisible="state != 'sent'" class="oe_highlight"/>
                    <button name="action_receive" type="object" string="Teslim Alındı"
                            invisible="state not in ('sent', 'in_progress')" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="İptal"
                            invisible="state in ('received', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,in_progress,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="treatment_line_id"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="tooth_number" readonly="1"/>
                            <field name="work_type"/>
                        </group>
                        <group>
                            <field name="lab_partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sent_date"/>
                            <field name="expected_date"/>
                            <field name="received_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notlar">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_lab_order" model="ir.actions.act_window">
        <field name="name">Laboratuvar Talepleri</field>
        <field name="res_model">dental.lab.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
