<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_commission_list" model="ir.ui.view">
        <field name="name">dental.commission.list</field>
        <field name="model">dental.commission</field>
        <field name="arch" type="xml">
            <list string="Acente Komisyonları">
                <field name="name"/>
                <field name="agency_id"/>
                <field name="patient_id"/>
                <field name="invoice_amount"/>
                <field name="commission_rate"/>
                <field name="amount"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'invoiced'"/>
            </list>
        </field>
    </record>

    <record id="view_dental_commission_form" model="ir.ui.view">
        <field name="name">dental.commission.form</field>
        <field name="model">dental.commission</field>
        <field name="arch" type="xml">
            <form string="Acente Komisyonu">
                <header>
                    <button name="action_mark_invoiced" type="object" string="Faturalandı"
                            invisible="state != 'pending'" class="oe_highlight"/>
                    <button name="action_mark_paid" type="object" string="Ödendi"
                            invisible="state != 'invoiced'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agency_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="treatment_plan_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_id" readonly="1"/>
                            <field name="invoice_amount" readonly="1"/>
                            <field name="commission_rate" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="payment_move_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_commission" model="ir.actions.act_window">
        <field name="name">Acente Komisyonları</field>
        <field name="res_model">dental.commission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
