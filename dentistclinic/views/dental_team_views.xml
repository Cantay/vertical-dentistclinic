<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_team_kanban" model="ir.ui.view">
        <field name="name">hr.employee.kanban.dental.team</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban class="o_hr_employee_kanban" sample="1">
                <field name="image_128"/>
                <field name="dental_website_published"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="avatar_128" widget="background_image" class="d-block position-relative"/>
                        </aside>
                        <main class="ms-2">
                            <div class="fw-bold fs-5">
                                <field name="dental_title"/> <field name="name"/>
                            </div>
                            <field name="dental_team_role" class="text-muted"/>
                            <field name="dental_specialty"/>
                            <div class="mt-auto">
                                <span t-if="record.dental_website_published.raw_value" class="badge text-bg-success">Sitede</span>
                                <span t-else="" class="badge text-bg-secondary">Sitede değil</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dental_team_list" model="ir.ui.view">
        <field name="name">hr.employee.list.dental.team</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Ekibimiz">
                <field name="dental_website_sequence" widget="handle"/>
                <field name="dental_website_separator_after" optional="show"/>
                <field name="name"/>
                <field name="dental_title"/>
                <field name="dental_team_role"/>
                <field name="dental_specialty"/>
                <field name="work_phone" optional="hide"/>
                <field name="work_email" optional="show"/>
                <field name="dental_website_published" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dental_team_form" model="ir.ui.view">
        <field name="name">hr.employee.form.dental.team</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Ekip Üyesi">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_dental_open_website_profile" class="oe_stat_button"
                                icon="fa-globe" invisible="not id or not dental_website_published">
                            <span>Profili Gör</span>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Ad Soyad"/>
                        <h1><field name="name" placeholder="Ad Soyad" required="1"/></h1>
                        <div class="o_row align-items-center text-muted mb-1">
                            <i class="fa fa-globe me-1" title="Web sitesinde görünen ad"/>
                            <field name="dental_website_name" class="o_text_overflow"
                                   placeholder="Sitede görünen ad (dile göre çevrilebilir, boşsa yukarıdaki ad)"/>
                        </div>
                        <field name="dental_title" placeholder="Ünvan (örn. Uzm. Dt.)"/>
                    </div>
                    <group>
                        <group string="Klinik">
                            <field name="dental_team_role" required="1"/>
                            <field name="dental_specialty"/>
                            <field name="is_dentist"/>
                            <field name="dental_online_booking" invisible="not is_dentist"/>
                            <field name="resource_calendar_id" string="Çalışma Saatleri" invisible="not is_dentist"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="İletişim">
                            <field name="work_phone" widget="phone"/>
                            <field name="mobile_phone" widget="phone"/>
                            <field name="work_email" widget="email"/>
                            <field name="dental_instagram_url" widget="url" placeholder="https://instagram.com/..."/>
                            <field name="dental_linkedin_url" widget="url" placeholder="https://linkedin.com/in/..."/>
                        </group>
                    </group>
                    <notebook>
                        <page name="profile" string="Profil">
                            <group>
                                <group>
                                    <field name="dental_career_start_year" options="{'format': false}"/>
                                    <field name="dental_experience_years" invisible="not dental_career_start_year"/>
                                    <field name="dental_language_ids" widget="many2many_tags"
                                           options="{'no_create': True}" placeholder="Türkçe, English, Deutsch…"/>
                                </group>
                                <group>
                                    <field name="dental_education" placeholder="Her satıra bir okul / derece"/>
                                </group>
                            </group>
                            <label for="dental_short_bio"/>
                            <field name="dental_short_bio" placeholder="Ekip listesinde görünecek 1-2 cümle"/>
                            <label for="dental_bio"/>
                            <field name="dental_bio" placeholder="Profil sayfasında görünecek detaylı biyografi"/>
                        </page>
                        <page name="website" string="Web Sitesi">
                            <group>
                                <group>
                                    <field name="dental_website_published"/>
                                    <field name="dental_website_show_contact"/>
                                    <field name="dental_website_sequence"/>
                                    <field name="dental_website_separator_after"/>
                                    <field name="dental_website_separator_heading"
                                           invisible="not dental_website_separator_after"/>
                                    <field name="dental_website_separator_title"
                                           invisible="not dental_website_separator_after or not dental_website_separator_heading"
                                           required="dental_website_separator_after and dental_website_separator_heading"/>
                                    <field name="dental_website_separator_text"
                                           invisible="not dental_website_separator_after or not dental_website_separator_heading"/>
                                    <field name="dental_website_url" widget="url" readonly="1"
                                           invisible="not id or not dental_website_published"/>
                                </group>
                                <group string="Ekip Kartı Fotoğrafı">
                                    <field name="dental_website_image" widget="image"
                                           options="{'preview_image': 'dental_website_image'}"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                Mobil numara hiçbir zaman sitede gösterilmez. İletişim seçeneği işaretliyse
                                sadece iş telefonu ve iş e-postası gösterilir.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_team_search" model="ir.ui.view">
        <field name="name">hr.employee.search.dental.team</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="dental_specialty"/>
                <filter name="dentists" string="Hekimler" domain="[('is_dentist', '=', True)]"/>
                <filter name="published" string="Sitede Yayında" domain="[('dental_website_published', '=', True)]"/>
                <filter name="not_published" string="Sitede Değil" domain="[('dental_website_published', '=', False)]"/>
                <group expand="0" string="Grupla">
                    <filter name="group_role" string="Ekip Rolü" context="{'group_by': 'dental_team_role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_team" model="ir.actions.act_window">
        <field name="name">Ekibimiz</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">['|', ('is_dentist', '=', True), ('dental_team_role', '!=', False)]</field>
        <field name="context">{'default_dental_team_role': 'dentist', 'default_is_dentist': True}</field>
        <field name="search_view_id" ref="view_dental_team_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_dental_team_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_dental_team_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dental_team_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">İlk ekip üyenizi ekleyin</p>
            <p>Hekimleri ve klinik ekibini buradan girin. "Web Sitesinde Göster" işaretli kişiler
               sitedeki Ekibimiz bölümünde ve kendi profil sayfalarında yayınlanır.</p>
        </field>
    </record>
</odoo>
