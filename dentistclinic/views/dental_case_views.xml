<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_case_list" model="ir.ui.view">
        <field name="name">dental.case.list</field>
        <field name="model">dental.case</field>
        <field name="arch" type="xml">
            <list string="Vakalar">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_dental_case_form" model="ir.ui.view">
        <field name="name">dental.case.form</field>
        <field name="model">dental.case</field>
        <field name="arch" type="xml">
            <form string="Vaka">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="treatment_plan_id"/>
                        </group>
                    </group>
                    <group string="Açıklama">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_case" model="ir.actions.act_window">
        <field name="name">Vakalar</field>
        <field name="res_model">dental.case</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
