<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_treatment_plan_list" model="ir.ui.view">
        <field name="name">dental.treatment.plan.list</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <list string="Tedavi Planları">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="recall_date" optional="show"/>
                <field name="recall_sent" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"
                       decoration-info="state in ('in_progress', 'quote')"/>
            </list>
        </field>
    </record>

    <record id="view_dental_treatment_plan_form" model="ir.ui.view">
        <field name="name">dental.treatment.plan.form</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <form string="Tedavi Planı">
                <header>
                    <button name="action_confirm" type="object" string="Onayla"
                            invisible="state not in ('quote', 'draft')" class="oe_highlight"/>
                    <button name="action_start" type="object" string="Başlat"
                            invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_done" type="object" string="Tamamla"
                            invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="İptal"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_create_sale_order" type="object"
                            string="Satış Siparişi Oluştur"
                            invisible="sale_order_id"/>
                    <button name="action_create_consent" type="object"
                            string="Onam Formu Oluştur"
                            invisible="not consent_feature_enabled"/>
                    <button name="%(action_report_dental_quote)d" type="action" string="Teklif PDF" icon="fa-file-pdf-o"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="quote,draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="consent_signed" readonly="1" widget="boolean_toggle"/>
                            <field name="is_remote_quote"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="crm_lead_id"/>
                            <label for="currency_id"/>
                            <div class="o_row">
                                <field name="currency_id" options="{'no_create': True, 'no_open': True}"/>
                                <button name="action_reprice" type="object" string="Fiyatları güncelle"
                                        class="btn-link p-0" icon="fa-refresh" invisible="not line_ids"
                                        help="Satır fiyatlarını seçili para birimindeki tedavi fiyatlarıyla yeniden doldurur."/>
                            </div>
                            <field name="quote_valid_until"/>
                            <field name="commission_rate"
                                   invisible="not patient_id or not patient_id.referring_agency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Tedavi Satırları">
                            <field name="dentition" invisible="1"/>
                            <field name="line_ids" widget="dental_odontogram">
                                <list editable="bottom">
                                    <field name="tooth_number" width="70px"/>
                                    <field name="tooth_dentition" widget="badge" optional="show"
                                           decoration-info="tooth_dentition == 'primary'"
                                           decoration-muted="tooth_dentition == 'permanent'"/>
                                    <field name="procedure_id" options="{'no_create': True}"
                                           domain="[('dental_is_procedure', '=', True), ('dental_dentition', 'in', ['all', tooth_dentition])] if tooth_dentition else [('dental_is_procedure', '=', True)]"/>
                                    <field name="doctor_id" placeholder="Plan hekimi"/>
                                    <field name="planned_start" placeholder="Seans tarihi seçin"/>
                                    <field name="duration" widget="float_time" width="70px"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="price_unit" width="100px"/>
                                    <field name="discount" width="70px" optional="show"/>
                                    <field name="price_subtotal" width="100px"/>
                                    <field name="appointment_id" optional="show"/>
                                    <field name="appointment_state" widget="badge" optional="hide"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2" name="dental_totals">
                                <field name="amount_subtotal"/>
                                <field name="global_discount"/>
                                <field name="amount_discount" invisible="not global_discount"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page name="recall" string="Kontrol (Recall)">
                            <group>
                                <field name="done_date" readonly="1"/>
                                <field name="recall_months"/>
                                <field name="recall_date" readonly="1"/>
                                <field name="recall_sent" readonly="1"/>
                            </group>
                        </page>
                        <page name="consents" string="Onam Formları">
                            <field name="consent_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="sent_date"/>
                                    <field name="signed_date"/>
                                    <field name="signer_name"/>
                                </list>
                            </field>
                        </page>
                        <page name="lab_orders" string="Laboratuvar Talepleri">
                            <field name="lab_order_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="lab_partner_id"/>
                                    <field name="work_type"/>
                                    <field name="tooth_number"/>
                                    <field name="expected_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="commissions" string="Acente Komisyonu"
                              invisible="not patient_id or not patient_id.referring_agency_id">
                            <field name="commission_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="agency_id"/>
                                    <field name="invoice_amount"/>
                                    <field name="commission_rate"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notlar">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_treatment_plan" model="ir.actions.act_window">
        <field name="name">Tedavi Planları</field>
        <field name="res_model">dental.treatment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
