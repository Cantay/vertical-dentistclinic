<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dental_quote" model="ir.actions.report">
        <field name="name">Tedavi Teklifi</field>
        <field name="model">dental.treatment.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dentistclinic.report_dental_quote</field>
        <field name="report_file">dentistclinic.report_dental_quote</field>
        <field name="print_report_name">'Teklif - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_dental_treatment_plan"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_dental_quote_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.patient_id.lang)"/>
            <div class="page">
                <div class="row mb-4">
                    <div class="col-7">
                        <h2 class="mb-1">Tedavi Teklifi</h2>
                        <div class="text-muted">Teklif no: <span t-field="o.name"/></div>
                    </div>
                    <div class="col-5 text-end">
                        <div><strong t-field="o.patient_id.name"/></div>
                        <div t-if="o.patient_id.mobile or o.patient_id.phone" t-out="o.patient_id.mobile or o.patient_id.phone"/>
                        <div class="mt-2">Tarih: <span t-out="context_timestamp(o.create_date).strftime('%d.%m.%Y')"/></div>
                        <div t-if="o.quote_valid_until">Geçerlilik: <span t-field="o.quote_valid_until"/></div>
                        <div t-if="o.doctor_id">Hekim: <span t-field="o.doctor_id.name"/></div>
                    </div>
                </div>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Tedavi</th>
                            <th class="text-center">Diş</th>
                            <th class="text-end">Fiyat</th>
                            <th class="text-end">İndirim</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.procedure_id.name"/></td>
                            <td class="text-center">
                                <t t-if="line.tooth_number">
                                    <span t-field="line.tooth_number"/>
                                    <small class="text-muted"> (<span t-field="line.tooth_dentition"/>)</small>
                                </t>
                                <t t-else="">—</t>
                            </td>
                            <td class="text-end"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            <td class="text-end"><t t-if="line.discount">%<span t-out="'%g' % line.discount"/></t></td>
                            <td class="text-end"><span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Ara toplam</td>
                                <td class="text-end"><span t-field="o.amount_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            </tr>
                            <tr t-if="o.amount_discount">
                                <td>Genel indirim (%<span t-out="'%g' % o.global_discount"/>)</td>
                                <td class="text-end">- <span t-field="o.amount_discount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            </tr>
                            <tr class="border-top border-dark">
                                <td><strong>Toplam</strong></td>
                                <td class="text-end"><strong t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <p class="text-muted small mt-4">
                    Bu teklif ön değerlendirmeye dayanır; kesin tedavi planı ve fiyat, klinik muayene
                    ve gerekli görüntülemelerden sonra hekiminiz tarafından belirlenir.
                </p>
            </div>
        </t>
    </template>

    <template id="report_dental_quote">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="dentistclinic.report_dental_quote_document"/>
            </t>
        </t>
    </template>
</odoo>
