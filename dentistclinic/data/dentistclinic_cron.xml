<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_dental_appointment_reminder" model="ir.cron">
        <field name="name">Diş Kliniği: Randevu Hatırlatmaları</field>
        <field name="model_id" ref="model_dental_appointment"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_appointment_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_dental_recall_reminder" model="ir.cron">
        <field name="name">Diş Kliniği: Kontrol (Recall) Hatırlatmaları</field>
        <field name="model_id" ref="model_dental_treatment_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_recall_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_dental_lab_order_overdue" model="ir.cron">
        <field name="name">Diş Kliniği: Geciken Laboratuvar Talepleri</field>
        <field name="model_id" ref="model_dental_lab_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_overdue_lab_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
