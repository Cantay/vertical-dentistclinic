<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dentistclinic" model="ir.module.category">
        <field name="name">Diş Kliniği</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_dentistclinic_user" model="res.groups">
        <field name="name">Klinik Personeli</field>
        <field name="category_id" ref="module_category_dentistclinic"/>
    </record>

    <record id="group_dentistclinic_manager" model="res.groups">
        <field name="name">Klinik Yöneticisi</field>
        <field name="category_id" ref="module_category_dentistclinic"/>
        <field name="implied_ids" eval="[(4, ref('group_dentistclinic_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_dentistclinic_manager'))]"/>
    </record>

    <!-- Özellik anahtarları: her ayar için menü görünürlüğünü kontrol eden
         teknik gruplar. res.company alanı değiştiğinde (bkz. models/res_company.py)
         klinik personeline otomatik atanır/kaldırılır; kullanıcı Ayarlar
         ekranından manuel değiştirmez. -->
    <record id="group_dentistclinic_feature_health_tourism" model="res.groups">
        <field name="name">Özellik: Sağlık Turizmi (teknik)</field>
        <field name="category_id" ref="module_category_dentistclinic"/>
    </record>

    <record id="group_dentistclinic_feature_whatsapp" model="res.groups">
        <field name="name">Özellik: WhatsApp (teknik)</field>
        <field name="category_id" ref="module_category_dentistclinic"/>
    </record>

    <record id="group_dentistclinic_feature_online_appointment" model="res.groups">
        <field name="name">Özellik: Online Randevu (teknik)</field>
        <field name="category_id" ref="module_category_dentistclinic"/>
    </record>

    <record id="group_dentistclinic_feature_lab_tracking" model="res.groups">
        <field name="name">Özellik: Laboratuvar Takibi (teknik)</field>
        <field name="category_id" ref="module_category_dentistclinic"/>
    </record>

    <record id="group_dentistclinic_feature_consent" model="res.groups">
        <field name="name">Özellik: Dijital Onam (teknik)</field>
        <field name="category_id" ref="module_category_dentistclinic"/>
    </record>

    <record id="dental_appointment_rule_company" model="ir.rule">
        <field name="name">Diş Randevusu: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_treatment_plan_rule_company" model="ir.rule">
        <field name="name">Tedavi Planı: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_treatment_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_case_rule_company" model="ir.rule">
        <field name="name">Diş Vakası: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_consent_rule_company" model="ir.rule">
        <field name="name">Onam Formu: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_consent"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_event_rule_company" model="ir.rule">
        <field name="name">Dental Event: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_event_request_rule_company" model="ir.rule">
        <field name="name">Etkinlik Başvurusu: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_event_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_lab_order_rule_company" model="ir.rule">
        <field name="name">Laboratuvar Talebi: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_lab_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_travel_info_rule_company" model="ir.rule">
        <field name="name">Seyahat Bilgisi: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_travel_info"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="dental_commission_rule_company" model="ir.rule">
        <field name="name">Komisyon: şirket bazlı erişim (klinik personeli)</field>
        <field name="model_id" ref="model_dental_commission"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_dentistclinic_user'))]"/>
    </record>

    <record id="dental_event_request_rule_company" model="ir.rule">
        <field name="name">Etkinlik Talebi: şirket bazlı erişim</field>
        <field name="model_id" ref="model_dental_event_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Acente Portal Erişimi -->
    <record id="group_dentistclinic_agency_portal" model="res.groups">
        <field name="name">Sağlık Turizmi Acentesi (Portal)</field>
        <field name="category_id" ref="base.module_category_user_type"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="dental_commission_rule_agency_portal" model="ir.rule">
        <field name="name">Komisyon: acente sadece kendi kayıtlarını görür</field>
        <field name="model_id" ref="model_dental_commission"/>
        <field name="domain_force">[('agency_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_dentistclinic_agency_portal'))]"/>
    </record>

    <record id="crm_lead_rule_agency_portal" model="ir.rule">
        <field name="name">CRM Fırsatı: acente sadece kendi yönlendirdiği lead'leri görür</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('agency_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_dentistclinic_agency_portal'))]"/>
    </record>

    <record id="dental_treatment_plan_rule_agency_portal" model="ir.rule">
        <field name="name">Tedavi Planı: acente sadece kendi yönlendirdiği hastaları görür</field>
        <field name="model_id" ref="model_dental_treatment_plan"/>
        <field name="domain_force">[('patient_id.referring_agency_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_dentistclinic_agency_portal'))]"/>
    </record>
</odoo>
